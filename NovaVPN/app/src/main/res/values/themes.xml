<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nova" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/nova_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown by the system before the first frame; MainActivity switches to Theme.Nova in onCreate -->
    <style name="Theme.Nova.Starting" parent="Theme.Nova">
        <item name="android:windowBackground">@color/nova_lime</item>
    </style>
</resources>
